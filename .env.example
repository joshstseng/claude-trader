# Copy to .env (git ignores it) and fill in. Never paste these into a chat.
# Walkthrough: plans/setup-alpaca-discord.md

# Alpaca: PAPER account keys only. The app refuses to start unless ALPACA_PAPER=true.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Discord bot
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=
DISCORD_CHANNEL_SETUPS=
DISCORD_CHANNEL_CLOSED_TRADES=
# Step 1b.9: one card per open trade, with buttons to manage it
DISCORD_CHANNEL_LIVE_TRADES=
DISCORD_CHANNEL_DAILY_SUMMARY=
DISCORD_CHANNEL_SYSTEM=
# Backtest summaries (only needed where backtests run, i.e. your Mac)
DISCORD_CHANNEL_BACKTESTS=
# Optional, on your Mac: each strategy's own Discord bot posts its backtests, e.g.
# DISCORD_BOT_TOKEN_DEMO=

# SEC EDGAR asks tools to identify themselves: "Your Name you@example.com"
SEC_USER_AGENT=
