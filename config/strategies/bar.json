{
  "id": "bar",
  "name": "Break and Retest (NQ, NY AM)",
  "enabled": false,
  "note": "Backtest only (app/strategies/bar.py). Times are Pacific. Defaults = the baseline (run #63 = #62, set 2026-11-20; before that #57 = #55, #52 = #49, #35).",
  "symbol": "MNQ",
  "data_source": "histdata",
  "window": {
    "name": "NYAM",
    "reference": "05:00",
    "breakouts_from": "06:05",
    "order_until": "08:00",
    "flat": "09:00",
    "after_flat": null,
    "hard_flat": "13:00"
  },
  "entry": {
    "midpoint": "body",
    "small_body_atr": 0.5,
    "cancel_if_target_first": true
  },
  "trend_filter": "mtf",
  "trend_big_candles": 0,
  "trend_legs_back": 1,
  "trend_votes": "event",
  "trend_leg": "older",
  "trend_half_life": null,
  "filters": {
    "ath_longs_only_pct": 0.5,
    "accumulation_since": "03:30"
  },
  "stop": {
    "swing_tf": "1h",
    "max_stop_atr": 3.0,
    "min_stop_points": 5,
    "buffer_ticks": 2
  },
  "target": {
    "mode": "levels",
    "level_min_r": 2.0,
    "level_max_r": 4.0,
    "default_r": 2.0,
    "flat_beyond_r": 3.0,
    "big_stop_atr": 2.0
  },
  "exit": {
    "breakeven_at_r": 2.0,
    "breakeven_level": "15m",
    "breakeven_level_min_r": 0.5,
    "breakeven_sig5m": true,
    "trail_gaps": true,
    "trail_1m_after_r": 2.0
  },
  "account": {
    "size_usd": 50000,
    "risk_pct": 0.01,
    "max_contracts": 20
  },
  "contract": {
    "tick": 0.25,
    "point_value": 2.0
  },
  "costs": {
    "commission_per_side": 0.75,
    "slippage_ticks": 1,
    "note": "limit entry and target: no slippage; stop and session-end exits: 1 tick"
  }
}
