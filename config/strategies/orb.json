{
  "id": "orb",
  "name": "Opening Range Breakout",
  "enabled": true,
  "interval": "5m",
  "opening_range_minutes": 15,
  "schedule": {
    "premarket_at": "08:30",
    "after_close_at": "16:15",
    "check_every_minutes": 5,
    "check_delay_minutes": 1
  },
  "focus_list": {
    "top_n_by_dollar_volume": 150,
    "min_price": 5,
    "include_daily_scan_hits": true,
    "max_daily_scan_hits": 50,
    "min_daily_volume": 1000000
  },
  "scan_window": {
    "start": "09:50",
    "end": "11:30"
  },
  "min_volume_x": 1.0,
  "exit": {
    "stop": "or-mid",
    "target": "2R"
  },
  "alerts": {
    "max_per_day": 5,
    "require_risk_pass": true,
    "stale_after_minutes": 10
  },
  "timemachine": {
    "enabled": true
  },
  "costs": {
    "pct_per_side": 0.0003,
    "note": "assumed spread + slippage until Step 1b measures real paper fills"
  },
  "orders": {
    "enabled": false,
    "entry": "limit",
    "limit_buffer_r": 0.1,
    "limit_buffer_pct": 0.1,
    "fill_timeout_seconds": 120,
    "stale_minutes": 5,
    "stale_drift_r": 0.25,
    "note": "Approve -> bracket order on the Alpaca PAPER account. OFF until Step 1b.6 (3:55 PM flatten) exists, so nothing can be left open overnight. enabled=false: Approve only records your choice."
  }
}
